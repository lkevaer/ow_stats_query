# 网易大神业务凭据；详见 LOGIN.md。不要提交真正的 .env。
OW_DASHEN_ROLE_ID=0
OW_DASHEN_TOKEN=
# 留空仅供本机使用；远程部署时设置自己的访问码。
OW_SERVER_API_KEY=
OW_RATING_CURRENT_SEASON=25
# 评分查询不排队：1取消评分任务容量、串行调度和评分请求入口容量上限。
# 默认0保持现有行为；请求体大小、身份验证和每用户限频仍有效。
OW_RATING_NO_QUEUE=0
# 底层API域名并发另由 OVERSTATS_DASHEN_MAX_CONCURRENT_REQUESTS 控制。
# 本次20人实测使用300；账号每秒请求预算仍由服务端配置控制。
# 可选：原始战绩缓存SQLite；留空使用 data/batch_rating_cache.sqlite3。
# 固定5分钟复用、24小时保留；Docker中应放在持久化数据卷内。
OW_RATING_CACHE_FILE=
# 可选：成功查询ID日志位置；留空使用 data/successful_battletags.txt。
OW_QUERY_ID_LOG_FILE=
# 保留旧行为：记录成功ID。公网可设0关闭，不影响评分和缓存。
OW_QUERY_ID_LOG_ENABLED=1
# 独立管理员凭据，仅在服务端配置；不要放入网页代码。
OW_ADMIN_API_KEY=
# 独立机器人服务凭据，对应插件 service_key；不能复用网页或管理员密钥。
OW_BOT_API_KEY=
# 默认只信任本机反向代理，按实际代理网络收窄；留空表示不信任转发头。
OW_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
OW_ENABLE_DOCS=0
OW_RATE_HEAVY_IP_PER_MIN=3
OW_RATE_BROWSER_COOLDOWN_SEC=30
OW_RATE_OCR_IP_PER_MIN=6
# 网页评分提交：普通查询每10秒2次；查询当局名单每60秒1次。
# 竞技/休闲共享各自计数，命中缓存也计次；持独立服务凭据的机器人豁免。
OW_RATE_RATING_REQUESTS=2
OW_RATE_RATING_WINDOW_SEC=10
OW_RATE_FULL_MATCH_COOLDOWN_SEC=60
